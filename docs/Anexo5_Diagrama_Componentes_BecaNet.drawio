        <mxCell id="subtitle" value="Arquitectura seleccionada: EN CAPAS (N-Layer / N-Tier) — separación estricta entre Presentación, API, Lógica de Negocio y Acceso a Datos" style="text;html=1;fontSize=12;align=left;fontStyle=1;" vertex="1" parent="1">
