# PLANTILLA systemd EnvironmentFile. Nunca guardar aquí los valores reales en Git.
# Instalar fuera del repo, root:root, 600. Compartir con web y trabajador.
DJANGO_SETTINGS_MODULE=becas_platform.settings
DEBUG=false
EMAIL_BACKEND=usuarios.email_backend.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
EMAIL_HOST_USER=REEMPLAZAR_PRIVADAMENTE
EMAIL_HOST_PASSWORD=REEMPLAZAR_PRIVADAMENTE
DEFAULT_FROM_EMAIL="GuateBecas <remitente@example.invalid>"
PASSWORD_RESET_PUBLIC_ORIGIN=https://dominio.example.invalid
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_RATE_WINDOW=900
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=20
# Solo si Gunicorn recibe exclusivamente desde el Nginx local validado:
PASSWORD_RESET_TRUSTED_PROXIES=127.0.0.1,::1
# SECRET_KEY y DB_* permanecen en el entorno privado de la app YA EXISTENTE.
# No pegar SECRET_KEY de demos, ROOT_URLCONF privado ni EMAIL_FILE_PATH de prueba.
