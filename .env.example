# Exporta estas variables en la terminal. Este archivo no se carga automáticamente.
DEBUG=true
SECRET_KEY=reemplazar-por-una-clave-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# DB_ENGINE=postgresql
# DB_NAME=becanet
# DB_USER=becanet
# DB_PASSWORD=cambiar
# DB_HOST=localhost
# DB_PORT=5432

# Correo local: no envía a bandejas reales. .env no se carga automáticamente.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para SMTP publicado: usuarios.email_backend.EmailBackend
# EMAIL_HOST=smtp.example.test
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# EMAIL_HOST_USER y EMAIL_HOST_PASSWORD: configurar fuera de Git, sin compartirlos.
# DEFAULT_FROM_EMAIL=GuateBecas <remitente@example.test>
# En producción: origen HTTPS canónico, sin ruta, query ni credenciales.
# PASSWORD_RESET_PUBLIC_ORIGIN=https://dominio.example.test
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_RATE_WINDOW=900
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=20
# Confiar solo en el proxy real. Nginx debe reemplazar X-Forwarded-For con $remote_addr.
# PASSWORD_RESET_TRUSTED_PROXIES=127.0.0.1,::1

# CA opcional para SMTP: certificado raíz de confianza, nunca una clave privada.
# macOS comprobado: /etc/ssl/cert.pem
# Ubuntu 24.04: /etc/ssl/certs/ca-certificates.crt
# EMAIL_CA_BUNDLE=/ruta/al/almacen-ca.pem
